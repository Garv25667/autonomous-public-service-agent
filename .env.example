# ==============================================================================
# Public Service Agent - Environment Configuration Template
# Copy this file to '.env' and fill in your actual Gemini API key.
# Never commit '.env' containing real secrets to version control.
# ==============================================================================

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=enter yout api key

# Gemini Model ID
# Recommended models: 'gemini-2.5-flash' or 'gemini-2.0-flash'
GEMINI_MODEL=gemini-2.5-flash

# Maximum LLM calls allowed per agent run (protects free-tier daily quota)
LLM_MAX_CALLS_PER_RUN=10

# Portal Configuration
PORTAL_BASE_URL=http://127.0.0.1:5000

# Browser Automation Settings
# Set to 'true' to run Playwright without a visible browser window
HEADLESS=false
